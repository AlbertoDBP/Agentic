# ── Database (self-hosted Postgres 18 + pgvector on legato) ─────────────────────
# Component vars feed the `postgres` container init AND the PgBouncer upstream.
# See documentation/deployment/migrate-do-postgres-to-self-hosted.md
PG_USER=dbpmanager
PG_PASSWORD=CHANGE_ME                 # NEW rotated password — do NOT reuse the old DO one
PG_HOST=postgres                      # docker service name (was: ...ondigitalocean.com)
PG_PORT=5432                          # was: 25060
PG_DATABASE=income_platform
DB_SCHEMA=platform_shared
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
#
# Services connect through PgBouncer (transaction pooling). Keep the same URL scheme
# your code expects — this platform uses postgresql+asyncpg:// (sync services strip
# the +asyncpg in code). No sslmode needed: traffic stays on the internal docker net.
PGBOUNCER_URL=postgresql+asyncpg://dbpmanager:CHANGE_ME@pgbouncer:5432/income_platform
# Direct admin URL (migrate.py / Alembic / psql). Bypasses the pooler:
DATABASE_URL=postgresql+asyncpg://dbpmanager:CHANGE_ME@postgres:5432/income_platform

# ── Cache (self-hosted Valkey on legato) ────────────────────────────────────────
# See documentation/deployment/migrate-do-valkey-to-self-hosted.md
REDIS_URL=redis://valkey:6379/0       # was: rediss://default:PASSWORD@...valkey...:25061

# ── Auth ──────────────────────────────────────────────────────────────────────
# Shared HS256 signing secret — must be identical across ALL services.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Internal service-to-service bearer token
SERVICE_TOKEN=

# ── Market Data Providers ─────────────────────────────────────────────────────
# Financial Modeling Prep (primary provider)  https://financialmodelingprep.com
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/api/v3
FMP_CALLS_PER_MINUTE=300
FMP_REQUEST_TIMEOUT=30

# Finnhub (tertiary fallback)  https://finnhub.io
FINNHUB_API_KEY=

# ── AI Providers ──────────────────────────────────────────────────────────────
# Anthropic Claude — newsletter signal extraction
ANTHROPIC_API_KEY=
ANTHROPIC_CALLS_PER_MINUTE=60
EXTRACTION_MODEL=claude-sonnet-4-6
EXTRACTION_MAX_TOKENS=4096
PHILOSOPHY_MODEL=claude-sonnet-4-6
PHILOSOPHY_MAX_TOKENS=2048

# OpenAI — embeddings (pgvector semantic search)
OPENAI_API_KEY=
OPENAI_CALLS_PER_MINUTE=60
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Seeking Alpha / Newsletter Ingestion (Agent 02) ───────────────────────────
# RapidAPI → Seeking Alpha plan  https://rapidapi.com/apidojo/api/seeking-alpha
APIDOJO_SA_API_KEY=
APIDOJO_SA_HOST=seeking-alpha.p.rapidapi.com
SA_ACCESS_TOKEN=
SA_CALLS_PER_MINUTE=30
SA_REQUEST_TIMEOUT=30
SA_FETCH_LIMIT_PER_ANALYST=10

# ── Inter-Service URLs ────────────────────────────────────────────────────────
# Docker Compose service names resolve automatically inside the network
MARKET_DATA_SERVICE_URL=http://market-data-service:8001
NEWSLETTER_SERVICE_URL=http://agent-02-newsletter-ingestion:8002

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=production
